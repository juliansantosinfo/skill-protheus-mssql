# Configuração de Conexão Microsoft SQL Server (TOTVS Protheus)
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=protheus
MSSQL_USER=sa
MSSQL_PASSWORD=SUBSTITUA_LOCALMENTE

# Modo de Execução: auto | docker | sqlcmd | python
MSSQL_CLIENT=auto
MSSQL_DOCKER_CONTAINER=totvs_mssql
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Segurança e Timeout
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MSSQL_COMMAND_TIMEOUT=30

